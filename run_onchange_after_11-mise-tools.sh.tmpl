#!/bin/bash

# Exit on error
set -e

# Ensure mise and local bins are in PATH
export PATH="$HOME/.local/bin:$HOME/.local/cli/bin:$PATH"

# Create CLI bin directory
mkdir -p "$HOME/.local/cli/bin"

# Function to check if a command exists
exists() {
    command -v "$1" >/dev/null 2>&1
}

# Install codebase-memory-mcp
if ! exists codebase-memory-mcp; then
    echo "Installing codebase-memory-mcp..."
    ARCH=$(uname -m)
    case $ARCH in
        x86_64)  ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        *)       echo "Unsupported architecture: $ARCH"; exit 1 ;;
    esac
    
    TMP_DIR=$(mktemp -d)
    cd "$TMP_DIR"
    wget -q https://github.com/DeusData/codebase-memory-mcp/releases/latest/download/codebase-memory-mcp-linux-${ARCH}.tar.gz -O codebase-memory-mcp.tar.gz
    tar xzf codebase-memory-mcp.tar.gz
    mv codebase-memory-mcp "$HOME/.local/cli/bin/codebase-memory-mcp"
    rm -rf "$TMP_DIR"
    echo "codebase-memory-mcp installed successfully."
else
    echo "codebase-memory-mcp already exists."
fi

# Configure firecrawl
if exists firecrawl; then
    echo "Configuring firecrawl API URL..."
    firecrawl config --api-url https://firecrawl.mmz.sh
else
    echo "firecrawl not found. Skipping configuration."
fi
